<Window x:Class="CinemaPR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaPR"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1200" Loaded="Window_Loaded">
    <Grid Background="#5646A8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="SeansDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="28,61,627,29" SelectionChanged="SeansDataGrid_SelectionChanged"
          Background="White"
          BorderBrush="#FF1F44A9"
          AlternatingRowBackground="#F4F5F7"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#FF4E85EB">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1F44A9"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- Цвет выделения строки (Светло-синий) -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF4E85EB"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название фильма" Binding="{Binding FilmName}" Width="*"/>
                <DataGridTextColumn Header="Длина (мин)" Binding="{Binding Length}" Width="100"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="80"/>
                <DataGridTextColumn Header="Время начала" Binding="{Binding Time, StringFormat=\{0:hh\\:mm\}}" Width="100"/>
                <DataGridTextColumn Header="Номер залы" Binding="{Binding HallNumber}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border BorderBrush="Black" Background="#211E68" BorderThickness="0" CornerRadius="5" Margin="634,61,72,97">
            <!-- Кнопки программно добавляем именно в WrapPanel -->
            <WrapPanel x:Name="MyContainer" Margin="-2,0,-2,-2" />
        </Border>
        <Button x:Name="ButtonTickets" Background="#211E68" Foreground="White" Content="Купить билет/ы" HorizontalAlignment="Left" Margin="634,504,0,0" VerticalAlignment="Top" Height="51" Width="494" Click="ButtonTickets_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Label Content="Выберите сеанса для покупки билета"  FontSize="18"  HorizontalAlignment="Left" Margin="28,17,0,0" VerticalAlignment="Top" Foreground="White"/>
        <Label Content="Выберите масто/а для просмотра" FontSize="18" HorizontalAlignment="Left" Margin="634,17,0,0" VerticalAlignment="Top" Foreground="White"/>

    </Grid>
</Window>
