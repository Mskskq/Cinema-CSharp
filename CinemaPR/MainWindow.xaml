<Window x:Class="CinemaPR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaPR"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1200" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="211*"/>
            <ColumnDefinition Width="989*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="SeansDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="28,27,627,265" Grid.ColumnSpan="2" SelectionChanged="SeansDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название фильма" Binding="{Binding FilmName}" Width="*"/>
                <DataGridTextColumn Header="Длина (мин)" Binding="{Binding Length}" Width="100"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="80"/>
                <DataGridTextColumn Header="Время начала" Binding="{Binding Time, StringFormat=\{0:hh\\:mm\}}" Width="100"/>
                <DataGridTextColumn Header="Номер залы" Binding="{Binding HallNumber}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border BorderBrush="Black" BorderThickness="2" CornerRadius="5" Margin="423,10,72,265" Grid.Column="1">
            <!-- Кнопки программно добавляем именно в WrapPanel -->
            <WrapPanel x:Name="MyContainer" Margin="-2,0,-2,-2" />
        </Border>

    </Grid>
</Window>
